{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clauding-thought.dev/manifest.schema.json",
  "title": "Clauding Thought Manifest",
  "description": "Project DNA — describes the stack, architecture, conventions, and boundaries of a codebase so that AI agents can generate code that fits.",
  "type": "object",
  "required": [
    "version",
    "stack",
    "architecture",
    "conventions"
  ],
  "$comment": "Read by the init skill from the plugin root (${CLAUDE_PLUGIN_ROOT}/schema/manifest.schema.json). Changes are additive within a manifest version.",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "Manifest schema version. 1.1 adds path-scoped rules, severity levels, and packs."
    },
    "project": {
      "type": "object",
      "description": "Basic project metadata",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "governance": {
      "type": "object",
      "description": "Versioning and metadata for the governance layer itself",
      "properties": {
        "version": {
          "type": "string",
          "description": "Semantic version of the governance layer (e.g., '1.2.0')",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "initialized": {
          "type": "string",
          "format": "date",
          "description": "Date the governance layer was first generated by the init skill"
        },
        "last_evolved": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date of the most recent /evolve run. Null for projects that have not yet evolved."
        },
        "changelog": {
          "type": "string",
          "description": "Path to the changelog file relative to .claude/",
          "default": "CHANGELOG.md"
        },
        "packs": {
          "type": "array",
          "description": "Community rule packs applied to this project",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Pack identifier (matches directory name in packs/)"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$",
                "description": "Version of the pack that was applied"
              },
              "applied": {
                "type": "string",
                "format": "date",
                "description": "Date the pack was applied or last updated"
              },
              "customized": {
                "type": "boolean",
                "default": false,
                "description": "Whether the user has modified pack-contributed rule sections"
              }
            },
            "required": [
              "name",
              "version",
              "applied"
            ]
          },
          "default": []
        },
        "plugin_version": {
          "type": "string",
          "description": "Clauding Thought plugin version that last wrote this governance layer."
        },
        "disabled_hooks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "secret-filter",
              "destructive-guard",
              "scope-guard",
              "anti-rationalization",
              "evidence-check",
              "claim-guard"
            ]
          },
          "default": [],
          "description": "Hooks the scaffold must not register. The self-test expects a disabled hook to be absent, and the report lists it. The documented way to turn a hook off."
        }
      }
    },
    "task_docs": {
      "type": "object",
      "description": "Configuration for per-task documentation",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to create task documents for significant changes"
        },
        "directory": {
          "type": "string",
          "default": "tasks",
          "description": "Directory under .claude/ where task documents are stored"
        },
        "auto_create_threshold": {
          "type": "object",
          "description": "When to automatically create a task document",
          "properties": {
            "min_files": {
              "type": "integer",
              "default": 3,
              "description": "Create doc when this many files will be modified"
            },
            "always_for": {
              "type": "array",
              "description": "Always create docs for these change types",
              "items": {
                "type": "string"
              },
              "default": [
                "migration",
                "security",
                "new-route",
                "cross-module"
              ]
            }
          }
        },
        "promote_lessons": {
          "type": "boolean",
          "default": true,
          "description": "When true, /close-task appends durable lessons to the task doc's Lessons section and flags rule candidates for /evolve."
        },
        "headings": {
          "type": "object",
          "description": "Section headings the hooks and skills look for in task docs. The generated task-doc skill writes these by default; change them here if the project renames sections.",
          "properties": {
            "scope": {
              "type": "string",
              "default": "Scope",
              "description": "Section listing one path glob per line that the task may write to. Read by scope-guard."
            },
            "thesis": {
              "type": "string",
              "default": "Thesis",
              "description": "Section stating the user-visible Claim, the Observable that proves it, and a Demonstrated line. Demonstrated counts only when the line starts with a date followed by how it was shown: `2026-10-30T10:00Z via /verify: ...` (a run) or `2026-10-30 attested by <who>: ...` (a person). A task with no user-visible outcome writes `no-user-observable-change: true`; one whose outcome cannot be shown locally writes `cannot-demonstrate-here: <reason>`."
            }
          }
        },
        "complexity": {
          "type": "object",
          "description": "Weights and thresholds for the complexity score that preflight computes (scripts/complexity.py). score = files*weights.files + cross_module*weights.cross_module + security_surface*weights.security_surface + new_archetype*weights.new_archetype. Tier: trivial below thresholds.medium, medium from there, high from thresholds.high. Medium routes into plan mode before editing; high also decomposes into sub-tasks.",
          "properties": {
            "weights": {
              "type": "object",
              "properties": {
                "files": {
                  "type": "number",
                  "default": 1,
                  "description": "Per file the task is expected to touch"
                },
                "cross_module": {
                  "type": "number",
                  "default": 3,
                  "description": "Added once when the files span more than one module from architecture.modules"
                },
                "security_surface": {
                  "type": "number",
                  "default": 3,
                  "description": "Added once when any file matches a security.checks[].paths glob"
                },
                "new_archetype": {
                  "type": "number",
                  "default": 2,
                  "description": "Added once when the task creates a file type with no sibling in the project"
                }
              },
              "description": "Non-negative finite numbers. The scorer rejects anything else."
            },
            "thresholds": {
              "type": "object",
              "properties": {
                "medium": {
                  "type": "number",
                  "default": 4
                },
                "high": {
                  "type": "number",
                  "default": 8
                }
              },
              "description": "Score boundaries; medium must be below high. The scorer rejects an inverted pair."
            }
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "description": "Technology stack detection results",
      "required": [
        "language",
        "framework"
      ],
      "properties": {
        "language": {
          "type": "string",
          "description": "Primary language",
          "examples": [
            "php",
            "typescript",
            "python",
            "go",
            "rust",
            "java"
          ]
        },
        "language_version": {
          "type": "string",
          "examples": [
            "8.4",
            "5.5",
            "3.12",
            "1.22"
          ]
        },
        "framework": {
          "type": "string",
          "description": "Primary backend framework",
          "examples": [
            "laravel",
            "nextjs",
            "django",
            "gin",
            "rails",
            "spring"
          ]
        },
        "framework_version": {
          "type": "string",
          "examples": [
            "12",
            "15",
            "5.1"
          ]
        },
        "frontend": {
          "type": "string",
          "description": "Frontend framework if applicable",
          "examples": [
            "vue3",
            "react",
            "svelte",
            "htmx",
            "blade",
            "none"
          ]
        },
        "bridge": {
          "type": "string",
          "description": "Backend-frontend bridge layer",
          "examples": [
            "inertia-v2",
            "api-rest",
            "graphql",
            "livewire",
            "trpc",
            "none"
          ]
        },
        "css": {
          "type": "string",
          "examples": [
            "tailwind-v4",
            "tailwind-v3",
            "scss",
            "css-modules",
            "styled-components"
          ]
        },
        "testing": {
          "type": "string",
          "examples": [
            "pest-v4",
            "phpunit",
            "jest",
            "vitest",
            "pytest",
            "go-test"
          ]
        },
        "db": {
          "type": "string",
          "examples": [
            "postgresql",
            "mysql",
            "sqlite",
            "mongodb",
            "none"
          ]
        },
        "orm": {
          "type": "string",
          "examples": [
            "eloquent",
            "prisma",
            "django-orm",
            "gorm",
            "sqlalchemy",
            "drizzle"
          ]
        },
        "packages": {
          "type": "object",
          "description": "Key packages/dependencies with versions. Informational metadata — provides context for human review and /evolve dependency analysis.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "description": "Architectural decisions and patterns detected in the codebase",
      "properties": {
        "tenancy": {
          "type": "object",
          "description": "Multi-tenancy strategy",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "column-scoped",
                "db-per-tenant",
                "schema-per-tenant",
                "subdomain",
                "none"
              ],
              "description": "How tenant isolation is achieved"
            },
            "scope_column": {
              "type": "string",
              "description": "Column name used for scoping (e.g., 'tenant_id', 'account_id')",
              "examples": [
                "tenant_id",
                "account_id",
                "workspace_id",
                "team_id"
              ]
            },
            "trait": {
              "type": "string",
              "description": "Trait, mixin, base class, or decorator that tenant-owned entities use for scoping",
              "examples": [
                "BelongsToTenant",
                "TenantScoped",
                "tenant_scoped"
              ]
            },
            "trait_path": {
              "type": "string",
              "description": "Source path or fully qualified name of that mechanism",
              "examples": [
                "src/models/concerns/BelongsToTenant",
                "app.core.tenancy.TenantScoped"
              ]
            },
            "global_scope": {
              "type": "boolean",
              "description": "Whether tenancy uses a global query scope"
            }
          }
        },
        "auth": {
          "type": "object",
          "description": "Authentication and authorization architecture",
          "properties": {
            "authentication": {
              "type": "string",
              "enum": [
                "session",
                "token",
                "jwt",
                "oauth",
                "api-key"
              ],
              "description": "How users authenticate"
            },
            "authorization": {
              "type": "object",
              "description": "How permissions and access control work",
              "properties": {
                "strategy": {
                  "type": "string",
                  "enum": [
                    "policy",
                    "gate",
                    "middleware",
                    "rbac-package",
                    "abac",
                    "mixed"
                  ],
                  "description": "Primary authorization pattern"
                },
                "patterns": {
                  "type": "array",
                  "description": "All authorization patterns in use with their scopes",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pattern": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "string"
                      },
                      "example": {
                        "type": "string"
                      }
                    }
                  }
                },
                "owner_bypass": {
                  "type": "boolean",
                  "description": "Whether owners/admins bypass permission checks"
                }
              }
            }
          }
        },
        "layers": {
          "type": "object",
          "description": "Application layer architecture",
          "properties": {
            "routing": {
              "type": "string",
              "description": "Where routes are defined"
            },
            "middleware": {
              "type": "string",
              "description": "Where middleware is registered"
            },
            "controllers": {
              "type": "string",
              "description": "Controller directory and style"
            },
            "services": {
              "type": "string",
              "description": "Service layer location (if any)"
            },
            "models": {
              "type": "string",
              "description": "Model/entity directory"
            },
            "validation": {
              "type": "string",
              "description": "Primary validation approach",
              "examples": [
                "request-class",
                "inline",
                "dto",
                "schema",
                "decorator"
              ]
            },
            "business_logic_location": {
              "type": "string",
              "enum": [
                "service",
                "action",
                "controller",
                "model",
                "command"
              ],
              "description": "Where business logic primarily lives"
            }
          }
        },
        "api_style": {
          "type": "string",
          "description": "How the backend serves data to clients",
          "examples": [
            "rest-json",
            "json-api",
            "graphql",
            "grpc",
            "trpc",
            "server-rendered",
            "inertia"
          ]
        },
        "modules": {
          "type": "array",
          "description": "Application modules/domains detected",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Directory of the module, relative to the project root, without a glob (e.g. src/billing). The complexity scorer matches files by this prefix; per-module rule files use `<path>/**` as their paths: glob."
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "file_storage": {
          "type": "object",
          "description": "File storage configuration. Populated by the init skill when filesystem/storage config is detected (e.g., filesystem.php, S3 config).",
          "properties": {
            "disk": {
              "type": "string",
              "examples": [
                "private",
                "public",
                "s3"
              ]
            },
            "auth_required": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "conventions": {
      "type": "object",
      "description": "Code style and convention choices specific to this project",
      "properties": {
        "controller_auth": {
          "type": "string",
          "description": "Where authorization checks happen in handlers",
          "examples": [
            "per-method",
            "constructor",
            "middleware-only",
            "decorator",
            "route-guard"
          ]
        },
        "validation_style": {
          "type": "string",
          "description": "How validation rules are written",
          "examples": [
            "request-class-array",
            "request-class-string",
            "inline",
            "dto",
            "schema"
          ]
        },
        "model_casts": {
          "type": "string",
          "description": "How entity attribute typing/casting is declared",
          "examples": [
            "method",
            "property",
            "annotations",
            "schema",
            "none"
          ]
        },
        "enum_labels": {
          "type": "string",
          "enum": [
            "translation-key",
            "hardcoded",
            "method"
          ],
          "description": "How enum display labels are provided"
        },
        "test_data": {
          "type": "string",
          "enum": [
            "factory",
            "manual",
            "fixture",
            "faker-inline"
          ],
          "description": "How test data is created"
        },
        "translation": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "description": "How translations are stored and looked up",
              "examples": [
                "nested-json",
                "flat-json",
                "gettext",
                "i18next",
                "intl",
                "resource-bundles",
                "none"
              ]
            },
            "locales": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "en",
                  "de",
                  "fr"
                ]
              ]
            },
            "all_locales_required": {
              "type": "boolean"
            }
          }
        },
        "naming": {
          "type": "object",
          "properties": {
            "files": {
              "type": "string",
              "enum": [
                "PascalCase",
                "camelCase",
                "kebab-case",
                "snake_case"
              ]
            },
            "classes": {
              "type": "string",
              "enum": [
                "PascalCase",
                "camelCase"
              ]
            },
            "methods": {
              "type": "string",
              "enum": [
                "camelCase",
                "snake_case"
              ]
            },
            "db_columns": {
              "type": "string",
              "enum": [
                "snake_case",
                "camelCase"
              ]
            },
            "routes": {
              "type": "string",
              "enum": [
                "kebab-case",
                "snake_case",
                "camelCase"
              ]
            }
          }
        },
        "formatting": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "examples": [
                "pint",
                "prettier",
                "black",
                "gofmt",
                "rustfmt"
              ]
            },
            "command": {
              "type": "string",
              "examples": [
                "php vendor/bin/pint --dirty",
                "npx prettier --write"
              ]
            }
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "description": "Module dependency rules — which modules can import from which",
      "properties": {
        "modules_may_import": {
          "type": "object",
          "description": "Map of module name -> array of modules it may import from",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "shared_layer": {
          "type": "string",
          "description": "Module/namespace that all modules can import from",
          "examples": [
            "core",
            "shared",
            "common"
          ]
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security-specific rules and checks. Security is non-negotiable — even non-public apps must follow strict practices because exposure status can change, internal threats exist, and compliance may require it.",
      "properties": {
        "posture": {
          "type": "string",
          "enum": [
            "strict",
            "advisory"
          ],
          "default": "strict",
          "description": "How security rules are enforced. 'strict': new code MUST meet all security rules — violations BLOCK. All new projects start here. 'advisory': existing patterns are respected, gaps are flagged as WARN with mitigation tasks generated — but the established codebase is not overridden. The init skill sets this automatically: empty/new projects get 'strict', existing codebases with established patterns get 'advisory' with a migration path toward strict."
        },
        "baseline_gaps": {
          "type": "array",
          "description": "Security gaps inherited from an existing codebase. Only populated when posture is 'advisory'. These are tracked debt — not exemptions.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier (e.g., 'gap-auth-001')"
              },
              "category": {
                "type": "string",
                "enum": [
                  "auth",
                  "tenancy",
                  "exposure",
                  "injection",
                  "secrets",
                  "file-access",
                  "csrf",
                  "session"
                ],
                "description": "Security domain"
              },
              "description": {
                "type": "string",
                "description": "What the gap is"
              },
              "scope": {
                "type": "string",
                "description": "Where it exists (file glob, module name, or 'project-wide')"
              },
              "affected_files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "File patterns affected"
              },
              "mitigation": {
                "type": "string",
                "description": "Recommended fix approach"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "in_progress",
                  "resolved"
                ],
                "default": "open"
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "description": "Security checks the QC agent must perform",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info",
                  "block",
                  "warn"
                ],
                "default": "error",
                "description": "How this finding affects the QC verdict. 'error' triggers BLOCK, 'warning' triggers WARN, 'info' is informational. 'block'/'warn' are accepted only for manifests written by 1.0."
              },
              "description": {
                "type": "string"
              },
              "detect": {
                "type": "string",
                "description": "How to detect this issue"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Glob patterns of files this check applies to. Absent or empty means all files for QC. The complexity scorer counts only checks that have paths as security surface, so give authorization, tenancy and exposure checks their globs."
              }
            }
          }
        },
        "sensitive_fields": {
          "type": "array",
          "description": "Field names that must never be exposed to frontend",
          "items": {
            "type": "string"
          },
          "examples": [
            [
              "password",
              "remember_token",
              "api_token",
              "secret"
            ]
          ]
        }
      }
    },
    "rule_defaults": {
      "type": "object",
      "description": "Default severity settings for rule evaluation. Individual rules can override these via inline annotations. Omit to use tier defaults.",
      "properties": {
        "security_severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "error",
          "description": "Default severity for security rules"
        },
        "architecture_severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "warning",
          "description": "Default severity for architecture rules"
        },
        "convention_severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "warning",
          "description": "Default severity for convention rules. Sections may override to 'error' for functional requirements (e.g., i18n contracts, data-format contracts) via inline `<!-- severity: error -->` annotations."
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "What counts as evidence in this project. Read by the evidence-check and claim-guard hooks. The init skill fills test_command and the first test gate from the detected runner; data gates are the project's own golden checks.",
      "properties": {
        "test_command": {
          "type": "string",
          "description": "Command that runs the test suite",
          "examples": [
            "npm test",
            "pytest",
            "go test ./...",
            "vendor/bin/phpunit"
          ]
        },
        "gates": {
          "type": "array",
          "description": "Executable checks whose successful output counts as evidence. kind=test backs claims that tests pass; kind=data backs claims about data or state.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string",
                "description": "Command the developer or agent runs"
              },
              "success_pattern": {
                "type": "string",
                "description": "Regular expression that matches the command's output when the gate passes. Must match a real line of output; a pattern that matches the empty string is ignored."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "test",
                  "data"
                ],
                "default": "test"
              },
              "success_when_silent": {
                "type": "boolean",
                "default": false,
                "description": "For tools that print nothing on success (type checkers, linters): the gate passes when a Bash command starting with `command` produced empty output."
              }
            }
          },
          "default": []
        },
        "claim_guard": {
          "type": "string",
          "enum": [
            "annotate",
            "block"
          ],
          "default": "annotate",
          "description": "annotate: claim-guard shows the user a note when a data/state claim has no gate in the window. block: it pushes back to the model once per turn."
        },
        "claim_window_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "How many turns back claim-guard and evidence-check look for gate output. 1 = the current turn only."
        },
        "llm_judge": {
          "type": "boolean",
          "default": false,
          "description": "When true, scaffold registers a prompt-type Stop hook that asks the background model whether the response dismisses a finding or asserts a data/state fact without evidence. One model call per turn end."
        }
      }
    }
  }
}
